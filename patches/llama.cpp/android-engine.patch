+JNIEXPORT jboolean JNICALL
+Java_com_arm_aichat_internal_InferenceEngineImpl_isVisionReadyNative(JNIEnv *, jobject /*unused*/) {
+    return (g_mtmd_context && mtmd_support_vision(g_mtmd_context)) ? JNI_TRUE : JNI_FALSE;
+}

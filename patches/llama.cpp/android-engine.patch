+extern "C"
+JNIEXPORT jint JNICALL
+Java_com_arm_aichat_internal_InferenceEngineImpl_loadVisionProjectorNative(
+        JNIEnv *env,
+        jobject /*unused*/,
+        jstring jmmproj_path
+) {
+    {
+        std::lock_guard<std::mutex> lock(aichat_error_mutex);
+        aichat_last_error.clear();
+    }
+    if (!g_model || !g_context) {
+        LOGe("Vision projector cannot be loaded before the text model is prepared");
+        return 1;
+    }
+    if (g_mtmd_context) {
+        mtmd_free(g_mtmd_context);
+        g_mtmd_context = nullptr;
+    }
+
+    const char *mmproj_path = env->GetStringUTFChars(jmmproj_path, nullptr);
+    if (!mmproj_path) return 2;
+
+    mtmd_context_params params = mtmd_context_params_default();
+    params.use_gpu = false;
+    params.n_threads = 2;
+    params.warmup = false;
+    // Keep image embedding growth bounded on mobile devices.
+    params.image_max_tokens = 512;
+
+    LOGi("Loading vision projector from %s", mmproj_path);
+    g_mtmd_context = mtmd_init_from_file(mmproj_path, g_model, params);
+    env->ReleaseStringUTFChars(jmmproj_path, mmproj_path);
+
+    if (!g_mtmd_context || !mtmd_support_vision(g_mtmd_context)) {
+        if (g_mtmd_context) {
+            mtmd_free(g_mtmd_context);
+            g_mtmd_context = nullptr;
+        }
+        std::lock_guard<std::mutex> lock(aichat_error_mutex);
+        if (aichat_last_error.empty()) {
+            aichat_last_error = "The selected text model and mmproj are incompatible or do not support vision.";
+        }
+        LOGe("Vision projector initialization failed or model has no vision support");
+        return 3;
+    }
+
+    LOGi("Vision projector loaded; vision support enabled");
+    return 0;
+}
+

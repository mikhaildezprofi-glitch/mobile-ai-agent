+extern "C"
+JNIEXPORT jint JNICALL
+Java_com_arm_aichat_internal_InferenceEngineImpl_processUserPromptWithImagesNative(
+        JNIEnv *env,
+        jobject /*unused*/,
+        jstring juser_prompt,
+        jobjectArray jimage_paths,
+        jint n_predict
+) {
+    if (!g_mtmd_context || !g_model || !g_context) {
+        LOGe("Image prompt requested without a loaded vision projector");
+        return 1;
+    }
+    const jsize image_count = env->GetArrayLength(jimage_paths);
+    if (image_count <= 0) {
+        LOGe("Image prompt has no image paths");
+        return 2;
+    }
+
+    {
+        std::lock_guard<std::mutex> lock(aichat_error_mutex);
+        aichat_last_error.clear();
+    }
+    reset_short_term_states();
+    common_sampler_reset(g_sampler);
+
+    const char *user_prompt = env->GetStringUTFChars(juser_prompt, nullptr);
+    if (!user_prompt) return 3;
+    std::string prompt_with_markers(user_prompt);
+    env->ReleaseStringUTFChars(juser_prompt, user_prompt);
+
+    const std::string marker = mtmd_default_marker();
+    for (jsize i = 0; i < image_count; ++i) {
+        prompt_with_markers += "\n";
+        prompt_with_markers += marker;
+    }
+
+    const bool has_chat_template = common_chat_templates_was_explicit(g_chat_templates.get());
+    std::string formatted_prompt = prompt_with_markers;
+    if (has_chat_template) {
+        formatted_prompt = chat_add_and_format(ROLE_USER, prompt_with_markers);
+    }
+
+    std::vector<mtmd_helper_bitmap_wrapper> wrappers;
+    std::vector<const mtmd_bitmap *> bitmaps;
+    wrappers.reserve(static_cast<size_t>(image_count));
+    bitmaps.reserve(static_cast<size_t>(image_count));
+
+    auto free_media = [&]() {
+        for (auto &wrapper : wrappers) {
+            if (wrapper.bitmap) mtmd_bitmap_free(wrapper.bitmap);
+            if (wrapper.video_ctx) mtmd_helper_video_free(wrapper.video_ctx);
+        }
+        wrappers.clear();
+        bitmaps.clear();
+    };
+
+    for (jsize i = 0; i < image_count; ++i) {
+        auto jpath = static_cast<jstring>(env->GetObjectArrayElement(jimage_paths, i));
+        if (!jpath) {
+            free_media();
+            return 4;
+        }
+        const char *path = env->GetStringUTFChars(jpath, nullptr);
+        if (!path) {
+            env->DeleteLocalRef(jpath);
+            free_media();
+            return 4;
+        }
+        auto wrapper = mtmd_helper_bitmap_init_from_file(
+                g_mtmd_context, path, false, mtmd_helper_init_opt_default());
+        env->ReleaseStringUTFChars(jpath, path);
+        env->DeleteLocalRef(jpath);
+        if (!wrapper.bitmap) {
+            wrappers.push_back(wrapper);
+            free_media();
+            LOGe("Failed to decode image attachment %d", static_cast<int>(i));
+            return 5;
+        }
+        bitmaps.push_back(wrapper.bitmap);
+        wrappers.push_back(wrapper);
+    }
+
+    mtmd_input_chunks *chunks = mtmd_input_chunks_init();
+    if (!chunks) {
+        free_media();
+        return 6;
+    }
+    mtmd_input_text text_input = {
+        formatted_prompt.data(), formatted_prompt.size(),
+        has_chat_template, has_chat_template
+    };
+    const int32_t tokenize_result = mtmd_tokenize(
+            g_mtmd_context, chunks, &text_input, bitmaps.data(), bitmaps.size());
+    free_media();
+    if (tokenize_result != 0) {
+        mtmd_input_chunks_free(chunks);
+        LOGe("mtmd_tokenize failed with code %d", tokenize_result);
+        return 7;
+    }
+
+    const llama_pos prompt_positions = mtmd_helper_get_n_pos(chunks);
+    if (prompt_positions <= 0 || current_position + prompt_positions >= DEFAULT_CONTEXT_SIZE - OVERFLOW_HEADROOM) {
+        mtmd_input_chunks_free(chunks);
+        LOGe("Image prompt exceeds available context; shorten the prompt or reduce image resolution");
+        return 8;
+    }
+
+    llama_pos new_position = current_position;
+    const int32_t eval_result = mtmd_helper_eval_chunks(
+            g_mtmd_context, g_context, chunks, current_position, 0,
+            BATCH_SIZE, true, &new_position);
+    mtmd_input_chunks_free(chunks);
+    if (eval_result != 0) {
+        LOGe("mtmd_helper_eval_chunks failed with code %d", eval_result);
+        return 9;
+    }
+
+    current_position = new_position;
+    stop_generation_position = current_position + std::max(1, static_cast<int>(n_predict));
+    LOGi("Image prompt evaluated successfully; %d image(s), new position %d",
+         static_cast<int>(image_count), static_cast<int>(current_position));
     return 0;
 }
 
